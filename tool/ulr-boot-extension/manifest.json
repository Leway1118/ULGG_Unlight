{
  "manifest_version": 3,
  "name": "ULR Boot",
  "version": "1.0.0",
  "description": "免 Steam 開啟 UNLIGHT:Revive 網頁版（由 ulr-companion 產生）",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.playunlight.online/*"
      ],
      "run_at": "document_start",
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shell.js"
      ],
      "matches": [
        "https://www.playunlight.online/*"
      ]
    }
  ]
}
