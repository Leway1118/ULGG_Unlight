# ULGG VPS -> GitHub server-sync exclusions
# Keep this list source-oriented: runtime state, secrets, backups and third-party
# dependency trees stay on the VPS / backup system, not in Git.

# Git / repository-maintained files
/.git/
/.gitignore
/README.md
/.github/

# Secrets and local environment
/.env
/.env.*
**/.ssh/
**/id_rsa*
**/id_ed25519*
*.pem
*.ppk
*.key

# Runtime / dependency trees
/venv311/
/vendor/
/cache/
/uploads/
/assets/uploads/
/assets/pay/
/assets/bower_components/
/highcharts/

# Debug / temporary / rollback copies
/_debug/
/test*.php
/api/_debug_*
/api/debug_*
**/__pycache__/
*.pyc
*.pyo
*.log
*.tmp
*.bak*
*.backup*
*.before_*
*before_*
*.sqlite*
.DS_Store
Thumbs.db

