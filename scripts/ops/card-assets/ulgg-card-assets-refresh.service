[Unit]
Description=UL.GG official card and skill assets transaction sync
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=root
Group=nginx
UMask=0027
WorkingDirectory=/opt/ulgg-card-assets
ExecStart=/usr/bin/python3 -B /opt/ulgg-card-assets/sync.py sync
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ulgg-card-assets /var/lib/ulgg-card-assets-private
ReadWritePaths=-/var/lib/php/session
TimeoutStartSec=20min
