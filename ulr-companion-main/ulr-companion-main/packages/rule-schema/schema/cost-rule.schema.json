{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/UnlightPlugin/ulr-companion/main/packages/rule-schema/schema/cost-rule.schema.json",
  "title": "ULR Cost Rule",
  "description": "UNLIGHT:Revive 自訂 COST 規則內容（schemaVersion 1）。此物件的 Canonical JSON 之 SHA-256 即為 contentHash。",
  "type": "object",
  "required": [
    "schemaVersion",
    "ruleSetId",
    "version",
    "name",
    "publisher",
    "gameVersion",
    "teamCostLimit",
    "characters"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "規則格式版本。與插件版本、規則版本都無關。"
    },
    "ruleSetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9-]{0,38}$",
      "description": "publisherSlug/ruleSlug，跨版本穩定識別（§5.1）。例：lampking/arcadia-balance"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?$",
      "description": "SemVer。正式版發布後不得重用（§5.3）。build metadata（+xxx）不允許，因為它不影響內容卻會改變 Hash。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "publisher": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,38}$",
          "description": "必須等於 ruleSetId 的前半段（由 validate.ts 額外檢查，JSON Schema 表達不了跨欄位相等）"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "contact": { "type": "string", "maxLength": 120 }
      }
    },
    "gameVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}$",
      "description": "這份 COST 表對應的遊戲版本，例：2026.07"
    },
    "appliesTo": {
      "enum": ["duel", "quest", "any"],
      "default": "duel"
    },
    "teamCostLimit": {
      "$ref": "#/$defs/cost",
      "description": "隊伍 COST 上限"
    },
    "characters": {
      "type": "object",
      "minProperties": 1,
      "$ref": "#/$defs/costTable",
      "description": "角色 → COST。鍵的格式見 docs/open-questions.md 的『角色 ID 用什麼』。"
    },
    "equipment": { "$ref": "#/$defs/costTable" },
    "eventCards": { "$ref": "#/$defs/costTable" },
    "compressionRule": {
      "description": "壓 C 規則。type 是白名單列舉，不接受任意字串（§12）。",
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": { "type": { "const": "none" } }
        },
        {
          "type": "object",
          "required": ["type", "bands"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "gap-band-v1" },
            "bands": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "required": ["minGap", "extraCost"],
                "additionalProperties": false,
                "properties": {
                  "minGap": { "$ref": "#/$defs/cost" },
                  "maxGap": { "$ref": "#/$defs/cost" },
                  "extraCost": { "$ref": "#/$defs/cost" }
                }
              }
            }
          }
        }
      ]
    },
    "restrictions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["target", "condition", "enforcement"],
        "additionalProperties": false,
        "properties": {
          "target": { "$ref": "#/$defs/entityId" },
          "condition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "⚠ 給人看的自由文字，引擎永遠不解析它。要做機器可強制的限制必須改用結構化條件（schemaVersion 2）。"
          },
          "enforcement": {
            "const": "agreement-only",
            "description": "schemaVersion 1 只支援自我約束。見 §12。"
          },
          "note": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "changelog": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "$defs": {
    "cost": {
      "type": "number",
      "minimum": -999,
      "maximum": 999,
      "description": "COST 值，最多兩位小數（0.01 精度）。⚠ 精度檢查不在這裡做 —— JSON Schema 的 multipleOf: 0.01 會用 value/0.01 判斷整除，而 4.35/0.01 = 434.99999999999994，合法的值會被誤判。改由 validate.ts 檢查十進位表示的小數位數，那是精確的。"
    },
    "entityId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,48}$"
    },
    "costTable": {
      "type": "object",
      "maxProperties": 2000,
      "propertyNames": { "$ref": "#/$defs/entityId" },
      "additionalProperties": { "$ref": "#/$defs/cost" }
    }
  }
}
