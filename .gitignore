# Environment files
.env
.env.*
!.env.example
steam/data/.env

# SSH/private key material
**/.ssh/
**/id_rsa
**/id_rsa_*
**/id_ed25519
**/id_ed25519_*
*.pem
*.ppk
*.key

# Local captures and backups
*.har
*.bak
*.backup
*~

# Dated local task script backups
/scripts/run_unlight_tasks_manual[0-9]*.sh

# Python 暫存
__pycache__/
*.pyc
*.pyo

# Node / Composer / 依賴
node_modules/
vendor/

# 系統檔案
.DS_Store
Thumbs.db
desktop.ini

# 遊戲/專案產生檔
steam/data/app.asar
steam/data/*.xml
steam/data/*.json
steam/data/*_backup/
steam/data/*_history_backup/

# 遊戲專案雜檔
steam/data/*.txt
steam/data/*[0-9].py
steam/data/index.html

# 不需要版控的目錄
bp/
qp/

# 其他不需要追蹤的檔案
*.log
*.tmp
*.log.env
uploads/
steam/data/backup/
install.txt
get-pip.py

# 資料庫 Dump
database/Dump*/

# 不需要的雜檔（限定路徑）
steam/data/*.pyw
steam/data/*.txt
# Tracker build / runtime output
/tool/unlight-card-tracker/detector/dist/
/tool/unlight-card-tracker/detector/build/
/tool/unlight-card-tracker/detector/output/
/tool/unlight-card-tracker/detector/deck/
/tool/unlight-card-tracker/detector/debug_frames/
/tool/unlight-card-tracker/detector/events.sqlite3
/tool/unlight-card-tracker/detector/*.sqlite3
/tool/unlight-card-tracker/detector/26.1.2
/tool/unlight-card-tracker/detector/self.expected_card_height

# Import captures
/scripts/import/har/*.har

# Watcher runtime state and backups
/watcher/*_backup/
/watcher/*_history_backup/
/watcher/probe_logs/
/watcher/room4_probe/*.json
/watcher/room4_probe/*.jsonl
/watcher/raid_probe/*.json
/watcher/channel*_room*.json
/watcher/ranking_*.json
/watcher/watcher_log.txt

# VPS runtime state, backups, and secrets
/vps/*_backup/
/vps/*_history_backup/
/vps/backup/
/vps/channel*_room*.json
/vps/ranking_*.json
/vps/maintenance_status.json
/vps/watcher_log.txt
/vps/.ssh/
/vps/my_vps_key.txt
/vps/my_vps_pri_key.ppk
/vps/ssh-rsa.txt

# Local audit and generated files
/dirty-status-before-cleanup.txt
/-before-cleanup.txt
/steam/data/diff.diff
/tool/unlight-card-tracker-v2-starter.zip


# Raid Bot source sync: keep code, exclude VPS runtime/secrets
/tool/raid-bot/.env
/tool/raid-bot/.env.*
!/tool/raid-bot/.env.example
/tool/raid-bot/data/
/tool/raid-bot/backup/
/tool/raid-bot/.git.disabled_*
/tool/raid-bot/*.before_*
/tool/raid-bot/**/*.before_*
/tool/raid-bot/*.bak_*
/tool/raid-bot/**/*.bak_*
/tool/raid-bot/*.backup_*
/tool/raid-bot/**/*.backup_*
/tool/raid-bot/*.tar.gz
/tool/raid-bot/False
/tool/raid-bot/True
/tool/raid-bot/db_raid_probe_debug.json
/tool/raid-bot/db_raid_probe_result.json
/tool/raid-bot/raid_observer_my_raid_probe.txt

# Server-sync safety boundary
/.gitignore
/.env
/.env.*
!/.env.example
/venv311/
/vendor/
/cache/
/assets/uploads/
/_debug/
/test*.php
/api/_debug_*
/api/debug_*

# Global rollback / emergency copies should stay on the VPS only
*.bak*
*.backup*
*.before_*

# Tracker local runtime/build state
/tool/unlight-card-tracker/detector/.venv/
/tool/unlight-card-tracker/detector/dist/
/tool/unlight-card-tracker/detector/build/
/tool/unlight-card-tracker/detector/output/
/tool/unlight-card-tracker/detector/debug_frames/
/tool/unlight-card-tracker/detector/log/

# VPS-only generated/build artifacts
/tool/unlight_bonus_navigator_exe_build/
/tool/TOOL_VPS.zip

# Third-party dependency trees are deployed artifacts, not application source
/assets/bower_components/
/highcharts/

# User/payment and local media assets are not source code
/assets/pay/
/tool/unlight-card-tracker/videos/

# Watcher live state / operational snapshots
/watcher/room_snapshots/
/watcher/jp_retired_snapshot_*/
/watcher/cr_paused_snapshot_*/
/watcher/channel*_room*.json*
/watcher/ranking_*.json*
/watcher/ranking_*_season_started_*.txt
/watcher/*.flag*
/watcher/import_and_compare(*).py

# Catch dated rollback copies such as foo_before_YYYYMMDD
*before_*

# Accidental shell-output file
/watcher/udo systemctl status unlight_watcher.service

# CDP source stays in Git; packaged Windows release artifacts stay on the VPS
/src/script/cdp-v*/
/src/script/cdp/cdp-v*/
/src/script/cdp/*.exe
/src/script/cdp/*.zip

# Retired local Stage Sync secret files
/tool/unlight-card-tracker/detector/raid_stage_sync_local_env.ps1
/doc/env.txt
